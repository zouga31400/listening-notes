# Copied to /etc/listening-notes/radio.env by install.sh (readable by root only).
# Same values as the GitHub secrets of the same name. Never commit the filled file.
MUSIC_EMAIL=
MUSIC_PASSWORD=
MUSIC_API_URL=
MUSIC_APP_ID=
MUSIC_WEB_URL=
STREAM_URL=
STREAM_URL_BACKUP=
NOTION_TOKEN=
# Errors are notified on this topic; the "show ended" signal is read from SHOW_END_TOPIC,
# or from NTFY_TOPIC when SHOW_END_TOPIC is empty (as on GitHub).
NTFY_TOPIC=
SHOW_END_TOPIC=
# Optional: health check pinged every 10 minutes while the server listens (e.g. a free
# healthchecks.io check, period 10 min, grace 30 min). HEALTHCHECK_URL is the show's own
# check, used only with offshow_show_here = yes.
OFFSHOW_HEALTHCHECK_URL=
HEALTHCHECK_URL=
# The server's logs are private (journalctl), so track names can be printed.
VERBOSE_LOGS=1
